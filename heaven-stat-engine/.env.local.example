# ─── Owner Identity (Server-Only) ──────────────────────────────────────────────
# Used in API routes to verify owner privileges and delete protection.
# Never prefix with NEXT_PUBLIC_.
OWNER_EMAIL=owner@example.com

# ─── App URL (used in email templates for absolute links) ─────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email Invites (Resend) ───────────────────────────────────────────────────
# Sign up at resend.com to obtain an API key for sending transactional invite emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Heaven Stat Engine <onboarding@resend.dev>

# ─── Firebase Configuration ───────────────────────────────────────────────────
# Copy this file to .env.local and fill in your Firebase project values.
# Get these from: Firebase Console → Your Project → Project Settings → Web App Config

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ─── Firebase App Check (reCAPTCHA v3) ────────────────────────────────────────
# 1. Create a reCAPTCHA v3 site key in Google Cloud Console.
# 2. In Firebase Console → App Check → Web Apps, register your reCAPTCHA v3 secret.
# 3. Put your public site key here.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key

# ─── Cloudinary Configuration (Optional for Avatar/Photo Uploads) ─────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# ─── Notes ────────────────────────────────────────────────────────────────────
# - Without these values, the app runs in Offline Demo Mode (localStorage only)
# - All values must start with NEXT_PUBLIC_ to be accessible in the browser
# - Add these same values to your Vercel project's Environment Variables
#   (Vercel Dashboard → Project → Settings → Environment Variables)
# - Do NOT commit .env.local to git (it is already in .gitignore)

# ─── Overlay API Authentication ──────────────────────────────────────────────
# Shared secret checked by every /api/overlay/* endpoint.
# Generate with: openssl rand -hex 32
# Copy this value into the Overlay Engine repo's environment as OVERLAY_API_KEY.
# The Overlay Engine must send it in the `x-overlay-api-key` header on every request.
OVERLAY_API_KEY=your-overlay-api-key-here
