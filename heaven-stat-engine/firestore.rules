rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Access functions ──────────────────────────────────────────────
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'ogadizion01@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ─── Overlay Engine collections ────────────────────────────────────
    // Public reads preserved (required for OBS Browser Source to render
    // without logging in). Writes allowed for ANY signed-in Firebase user —
    // access is controlled by who has a Firebase Auth account at all
    // (created manually by the owner in the Firebase Console), not by an
    // email allowlist maintained in this rules file.
    match /overlayTemplates/{templateId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /overlaySlots/{slotId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /overlayDataFieldCatalog/{catalogId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─── Heaven Stat Engine's own data ─────────────────────────────────
    // Public reads preserved (Overlay Engine's public render page and OBS
    // need to read team names/logos/tournament data without logging in).
    // Writes restricted to the owner ONLY — this is Heaven's own analytics
    // data; no collaborator should ever create or edit it.
    match /tournaments/{tournamentId}/{document=**} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /clans/{clanId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ─── Fallback rule for anything else — strictest default ──────────
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}

